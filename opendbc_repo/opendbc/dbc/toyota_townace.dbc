CM_ SG_ 161 SPEED "verified, km/h, same raw value as BUTTONS.UI_SPEED (dash)";
CM_ SG_ 161 BRAKE_ENGAGED "verified 2026-11-17: 1 = brake pedal pressed";
CM_ SG_ 161 BRAKE_PRESSURE "verified 2026-11-17/19 as pressure: raw 0 released, ~65 light, ~120 hard, 255 on the floor (8-bit limit, saturates); unit unknown";
CM_ SG_ 524 GEAR "verified 2026-11-17: one bit per lever position. R 0x80, N 0x40, D 0x20, 2 0x10, L 0x08. Reads 0 in P (use PARK) and for about 0.1 s while the lever moves between positions (0x04 seen once in P)";
CM_ SG_ 524 PARK "verified 2026-11-17: 1 = lever in P";
CM_ SG_ 524 GEAR_ACTUAL "NOT verified: 1 in D/2/L, 0 in P/R/N while parked, 2-4 while driving; looks like the gearbox gear";
CM_ SG_ 900 HANDBRAKE_ENGAGED "verified 2026-11-17: 1 = handbrake pulled";
CM_ SG_ 608 WHEELSPEED "km/h, tracks BRAKE.SPEED about 2% lower; scale from the capture, not calibrated";
CM_ SG_ 409 SPEED "km/h, tracks BRAKE.SPEED about 2-3% lower; scale from the capture, not calibrated";
CM_ SG_ 398 APPS_1 "verified 2026-11-17: accelerator pedal position 0-100 % (raw 0-6400), engine off and running";
CM_ SG_ 398 APPS_3 "verified 2026-11-24 (Fred, against the tachometer): engine speed, raw = rpm (1:1); 0 with the engine off";
CM_ SG_ 399 IS_ACCEL "verified 2026-11-17: name is inverted, 1 = accelerator released, 0 = pressed";
CM_ SG_ 520 GAS_FULL "seen 2026-11-17: 1 with the pedal on the floor, 0 at ~20 %; threshold not measured";
CM_ BO_ 422 "Sent by lowcostPedal (not by the car), 20 ms (50 Hz). Layout follows Honda CR-V 2016 SCM_BUTTONS (0x1A6) for the buttons; byte 7 is the Toyota checksum, byte 6 a 4-bit counter. Town Ace has no 0x1A6 of its own (checked on the 2026-09 captures). Added 2026-11-20, architecture A: the board runs cruise, this message only reports it";
CM_ SG_ 422 CRUISE_BUTTONS "cruise stalk button held now (from the J1-21 resistor ladder)";
CM_ SG_ 422 CRUISE_STATE "lowcostPedal cruise state machine";
CM_ SG_ 422 SET_SPEED "cruise set speed, km/h; 0 when no speed has been set";
CM_ SG_ 422 MAIN_ON "1 = stalk ON/OFF is ON (state READY, CRUISE or OVERRIDE)";
CM_ SG_ 422 COUNTER "0..15, +1 every frame";
CM_ SG_ 422 CHECKSUM "Toyota: (sum of bytes 0-6 + 0x01 + 0xA6 + 8) & 0xFF";
CM_ BO_ 1446 "Sent by lowcostPedal (not by the car), 50 ms (20 Hz), debug only, off when CAN_SEND_DEBUG 0. Shown by lowcostPedal_monitor_uno (UNO + LCD). 0x5A6 not seen on the Town Ace bus (2026-09 and 2026-11-17 captures). Byte 6 bit 4 reserved, sent 0. Values are sent as they are (no N/A code), 4095 = 8.19 V or more. Added 2026-11-22";
CM_ SG_ 1446 ACC_IN_1 "pedal sensor 1 at A0, ADC x AREF_V / 1023";
CM_ SG_ 1446 ACC_IN_2 "pedal sensor 2 at A1, ADC x AREF_V / 1023";
CM_ SG_ 1446 ACC_OUT_1 "output 1 to the PCM, from the measured duty -> mV table OUT1_TAB (commanded, not measured)";
CM_ SG_ 1446 ACC_OUT_2 "output 2 to the PCM, from OUT2_TAB (commanded, not measured)";
CM_ SG_ 1446 PCM5V_OK "1 = A2 PCM 5V >= PCM5V_MIN_ADC";
CM_ SG_ 1446 PEDAL_DIFF_OK "1 = IN2 - IN1 within PEDAL_DIFF_ADC +- PEDAL_DIFF_TOL_ADC";
CM_ SG_ 1446 OUT_FROM_CRUISE "1 = output comes from the cruise PID, 0 = pedal passthrough";
CM_ SG_ 1446 COUNTER "0..15, +1 every frame";
CM_ SG_ 1446 CHECKSUM "Toyota: (sum of bytes 0-6 + 0x05 + 0xA6 + 8) & 0xFF";
CM_ BO_ 1447 "Sent by lowcostPedal (not by the car), 50 ms (20 Hz), debug only, off when CAN_SEND_DEBUG 0; TX buffer 1, alternating with 0x5A6. Shown and logged by lowcostPedal_monitor_uno. 0x5A7 not seen on the Town Ace bus. Added 2026-11-23 to find which state the board is in when the MIL comes on while driving";
CM_ SG_ 1447 STATE "cruise state, same values as 0x1A6 CRUISE_STATE without OVERRIDE (see CTRL_SUB)";
CM_ SG_ 1447 CTRL_SUB "while CRUISE: cruise_ctrl sub-state; 15 = not cruising";
CM_ SG_ 1447 REASON "last cancel / refuse / fault reason (debug line last=), code list in pedal_debug.h";
CM_ SG_ 1447 RELAY_ON "1 = RLY_SW master switch on (D6), PCM gets the board outputs";
CM_ SG_ 1447 BRAKE "1 = brake light line (A6) above BRAKE_ON_ADC";
CM_ SG_ 1447 GEAR_OK "1 = 0x20C gear D/2/L (within GEAR_LOST_MS)";
CM_ SG_ 1447 SPEED_OK "1 = 0x0A1 speed received within CAN_SPEED_TIMEOUT_MS";
CM_ SG_ 1447 HANDBRAKE "1 = 0x384 handbrake pulled";
CM_ SG_ 1447 DRIVER_ACTIVE "1 = CRUISE with the driver overriding or coasting";
CM_ SG_ 1447 OUT2_AT_MAX "1 = since the previous 0x5A7 an output was cut at its cap (output 1 3548 mV, output 2 4348 mV; 0.8 V kept at the top, 2026-11-23)";
CM_ SG_ 1447 OUT_AT_FLOOR "1 = since the previous 0x5A7 an output was raised to its fixed floor (733 / 1534 mV)";
CM_ SG_ 1447 RESET_CAUSE "bit 3 watchdog: the WDT interrupt fired (a hang of ~125 ms) before this start and the loop never cleared the mark; normally the watchdog reset ~125 ms later, but an external reset inside that window also gives bit 3, and a watchdog reset whose interrupt never ran gives 0. Bits 2..0 brown-out / external / power-on only when a bootloader left MCUSR (the shipped optiboot clears it); 0 = unknown";
CM_ SG_ 1447 BOOT_COUNT "boot counter kept in EEPROM, low 4 bits; a change = the board restarted";
CM_ SG_ 1447 LOOP_MAX_MS "longest completed loop() since the previous 0x5A7, ms; 255 = 255 ms or more, or a watchdog stage-1 timeout the loop recovered from";
CM_ SG_ 1447 SPEED_KPH "speed the board uses (0x0A1), 0 when timed out";
CM_ SG_ 1447 EVENT_SEQ "+1 when the state at the end of a loop() differs from the previous loop (STATE, CTRL_SUB or REASON); two changes inside one loop count once";
CM_ SG_ 1447 COUNTER "0..15, +1 every frame";
CM_ SG_ 1447 CHECKSUM "Toyota: (sum of bytes 0-6 + 0x05 + 0xA7 + 8) & 0xFF";
VAL_ 627 FOLLOW_DISTANCE 2 "1bar" 1 "2bar" 0 "3bar" ;
VAL_ 513 STATE 5 "FAULT_TIMEOUT" 4 "FAULT_STARTUP" 3 "FAULT_SCE" 2 "FAULT_SEND" 1 "FAULT_BAD_CHECKSUM" 0 "NO_FAULT" ;
VAL_ 524 GEAR 128 "R" 64 "N" 32 "D" 16 "2" 8 "L" 4 "P" 0 "NONE" ;

